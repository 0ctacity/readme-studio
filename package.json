    "vite": "^8.1.5",
    "wrangler": "^4.127.0"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.0-rc.0",
    "dompurify": "^3.4.13",
    "hono": "^4.13.3",
    "jose": "^6.2.9",
    "marked": "^18.0.10",
    "solid-js": "^2.0.0-rc.0"
  }
