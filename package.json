{
  "name": "readme-studio",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p worker/tsconfig.test.json",
    "serve": "vite preview",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:types": "wrangler types --config worker/wrangler.jsonc",
    "worker:check": "wrangler types --check --config worker/wrangler.jsonc && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p worker/tsconfig.test.json",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "license": "MIT",
